# WorldForge AI — Environment Variables
# Copy this file to .env and fill in your values.
# Then run: source .env (Linux/Mac) or set the vars in Windows.

# REQUIRED: Your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: Set a fixed secret key for sessions (auto-generated and persisted if omitted)
# SECRET_KEY=your-random-secret-here
